    "send": "^0.19.0",
    "serve-static": "^1.16.2",
    "on-headers": "^1.1.0",
    "@grpc/grpc-js": "^1.8.22",
    "protobufjs": "^7.2.5",
    "dset": "^3.1.4",
    "sharp": "^0.32.6",
    "postcss": "^8.4.31",
    "fast-xml-parser": "^5.2.0",
    "zod": "^3.22.3",
    "lodash": "^4.17.21"
